# DSFDetect Environment Variables
# Copy this file to .env and fill in your values

# CodeQL CLI path
CODEQL_CLI=/Users/mycp/CodeQL/codeql-cli/codeql/codeql

# CodeQL databases directory
CODEQL_DB_DIR=/Users/mycp/CodeQL/databases

# CodeQL repository directory
CODEQL_REPO_DIR=/Users/mycp/CodeQL/codeql-repo/codeql-main

# OpenAI API configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=gpt-3.5-turbo
